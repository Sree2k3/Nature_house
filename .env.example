# ─────────────────────────────────────────────────────────
# NATURE HOUSE — LOCAL DEVELOPMENT ENVIRONMENT
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────

# ── LOCAL POSTGRESQL (Phase 2 Local Testing) ──────────────
# Use these during local dev before switching to Supabase
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/nature_house
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nature_house
DB_USER=postgres
DB_PASSWORD=yourpassword

# ── SUPABASE (Phase 5 Production) ─────────────────────────
# Get these from: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── NURSERY CONTACT & STORE INFO ─────────────────────────
NEXT_PUBLIC_WHATSAPP_PHONE=917908340234
NEXT_PUBLIC_STORE_NAME=Nature House
NEXT_PUBLIC_STORE_ADDRESS=Nature House, Ashram Para, Near East Rly Cabin, Adra, Purulia, West Bengal
NEXT_PUBLIC_STORE_PINCODE=723121
NEXT_PUBLIC_GOOGLE_MAPS_URL=https://maps.app.goo.gl/jo8HbjBLH6dxLjpDA?g_st=aw

# ── STORE OPERATING HOURS (24h IST format) ───────────────
NEXT_PUBLIC_OPEN_TIME=09:00
NEXT_PUBLIC_CLOSE_TIME=20:30
NEXT_PUBLIC_OPEN_DAYS=Monday - Saturday

# ── ADMIN AUTHENTICATION & ACCESS CONTROL (Strict 3-Admin Quota) ──
# Option A: Comma-separated list of up to 3 authorized admin email accounts
AUTHORIZED_ADMIN_EMAILS=admin@naturehouse.in,botanist@naturehouse.in,manager@naturehouse.in

# Option B: Individual admin email environment variables
ADMIN_EMAIL_1=admin@naturehouse.in
ADMIN_EMAIL_2=botanist@naturehouse.in
ADMIN_EMAIL_3=manager@naturehouse.in

# Optional custom admin password (overrides default PBKDF2 hash)
ADMIN_PASSWORD=nature2026

# Cryptographic secret for signing HMAC-SHA256 session and reset tokens
SESSION_SECRET=nature_house_cryptographic_signing_key_change_in_production

# Random string used for on-demand ISR cache revalidation
REVALIDATION_SECRET=change_this_to_a_random_32_char_string

# ── ENV SWITCH ────────────────────────────────────────────
# Set to "local" during development, "supabase" for production
NEXT_PUBLIC_DB_PROVIDER=local
